# ==========================================
# EmailJS Konfiguration (über import.meta.env)
# ==========================================
# Tragen Sie diese Werte in Ihrer lokalen .env Datei
# oder in Netlify unter Site Configuration -> Environment Variables ein:

VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
